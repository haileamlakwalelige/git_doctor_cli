{
  "name": "git-doctor-cli",
  "version": "0.1.3",
  "description": "Diagnose broken and confusing Git repositories. Like ESLint for your Git repo.",
  "homepage": "https://haileamlakwalelige.github.io/git_doctor_cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haileamlakwalelige/git_doctor_cli.git"
  },
  "bugs": {
    "url": "https://github.com/haileamlakwalelige/git_doctor_cli/issues"
  },
  "keywords": [
    "git",
    "git-doctor",
    "git-doctor-cli",
    "cli",
    "diagnostics",
    "repository",
    "static-analysis",
    "lint",
    "secrets",
    "large-files",
    "recovery",
    "devtools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "git-doctor-cli": "dist/cli.js",
    "git-doctor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
